allow system_suspend block_device:dir search;
allow system_suspend sysfs_rtc:dir r_dir_perms;
allow system_suspend sysfs_rtc:file r_file_perms;
allow system_suspend sysfs_wakeup:dir r_dir_perms;
allow system_suspend sysfs_wakeup:file r_file_perms;
allow system_suspend sysfs_power:dir r_dir_perms;
allow system_suspend sysfs_type:dir r_dir_perms; 
allow system_suspend system_server:fd use;
allow system_suspend same_process_hal_file:file { read open getattr };
binder_call(system_suspend, system_server)
dontaudit system_suspend sysfs:file r_file_perms;
