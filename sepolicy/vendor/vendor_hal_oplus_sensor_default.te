type vendor_hal_oplus_sensor_default, domain;
hal_server_domain(vendor_hal_oplus_sensor_default, vendor_hal_oplus_sensor)

type vendor_hal_oplus_sensor_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_oplus_sensor_default)

binder_call(vendor_hal_oplus_sensor_client, vendor_hal_oplus_sensor_server)
binder_call(vendor_hal_oplus_sensor_server, vendor_hal_oplus_sensor_client)

hal_attribute_hwservice(vendor_hal_oplus_sensor, vendor_hal_oplus_sensor_hwservice)

allow vendor_hal_oplus_sensor_default block_device:dir search;
allow vendor_hal_oplus_sensor_default mnt_vendor_file:dir search;
allow vendor_hal_oplus_sensor_default persist_data_file:dir search;
allow vendor_hal_oplus_sensor_default oplus_block_device:blk_file r_file_perms;
allow vendor_hal_oplus_sensor_default als_ps_device:chr_file r_file_perms;
allow vendor_hal_oplus_sensor_default vendor_proc_oplus_sensor_feature:dir search;
allow vendor_hal_oplus_sensor_default vendor_proc_oplus_sensor_feature:file r_file_perms;

r_dir_file(vendor_hal_oplus_sensor_default, persist_engineer_file)
r_dir_file(vendor_hal_oplus_sensor_default, vendor_proc_oplus_version)
rw_dir_file(vendor_hal_oplus_sensor_default, vendor_proc_oplus_als_file)

get_prop(hal_sensors_default, vendor_oplus_sensor_prop)
get_prop(hal_sensors_default, vendor_default_prop)
