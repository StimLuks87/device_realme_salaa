dontaudit mobicore system_prop:file r_file_perms;
dontaudit mobicore shell_data_file:dir search;
allow mobicore tee_device:chr_file rw_file_perms;
allow mobicore self:capability { net_admin };

get_prop(mobicore, system_oplus_project_prop)
get_prop(mobicore, vendor_audio_prop)
get_prop(mobicore, vendor_oplus_prop)
