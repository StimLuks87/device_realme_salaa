dontaudit untrusted_app app_data_file:file r_file_perms;
dontaudit untrusted_app block_device:dir r_dir_perms;
dontaudit untrusted_app proc_cpufreq:dir r_dir_perms;
dontaudit untrusted_app proc_stat:dir r_dir_perms;
dontaudit untrusted_app proc_bus_input:file r_file_perms;
dontaudit untrusted_app proc:file r_file_perms;
dontaudit untrusted_app proc_net:file r_file_perms;
dontaudit untrusted_app proc_tty_drivers:file r_file_perms;
dontaudit untrusted_app sysfs_soc:dir r_dir_perms;
dontaudit untrusted_app system_lib_file:file execmod;
dontaudit untrusted_app system_oplus_camera_prop:file read;
dontaudit untrusted_app vendor_persist_camera_prop:file read;
dontaudit untrusted_app media_rw_data_file:file relabelfrom;
dontaudit untrusted_app userdata_block_device:blk_file r_file_perms;

allow untrusted_app media_userdir_file:dir search;
