# Incremental
get_prop(untrusted_app, incremental_prop)

# To get signature of an APK installed on Incremental File System, and fill in data
# blocks and get the filesystem state
allowxperm untrusted_app apk_data_file:file ioctl {
  INCFS_IOCTL_READ_SIGNATURE
  INCFS_IOCTL_FILL_BLOCKS
  INCFS_IOCTL_GET_FILLED_BLOCKS
  INCFS_IOCTL_GET_BLOCK_COUNT
  F2FS_IOC_GET_FEATURES
  F2FS_IOC_GET_COMPRESS_BLOCKS
  F2FS_IOC_COMPRESS_FILE
  F2FS_IOC_DECOMPRESS_FILE
  F2FS_IOC_RELEASE_COMPRESS_BLOCKS
  F2FS_IOC_RESERVE_COMPRESS_BLOCKS
  FS_IOC_SETFLAGS
  FS_IOC_GETFLAGS
};

allow untrusted_app proc_max_map_count:file read;
allow untrusted_app proc_pid_max:file read;
dontaudit untrusted_app proc_filesystems:file read;
dontaudit untrusted_app system_bootstrap_lib_file:dir read;
dontaudit untrusted_app app_data_file:file r_file_perms;
dontaudit untrusted_app block_device:dir r_dir_perms;
dontaudit untrusted_app proc_version:file read;
dontaudit untrusted_app proc_cpufreq:dir r_dir_perms;
dontaudit untrusted_app proc_stat:dir r_dir_perms;
dontaudit untrusted_app proc_bus_input:file r_file_perms;
dontaudit untrusted_app proc:file r_file_perms;
dontaudit untrusted_app proc_net:file r_file_perms;
dontaudit untrusted_app proc_tty_drivers:file r_file_perms;
dontaudit untrusted_app sepolicy_file:file read;
dontaudit untrusted_app sysfs_soc:dir r_dir_perms;
dontaudit untrusted_app system_lib_file:file execmod;
dontaudit untrusted_app system_oplus_camera_prop:file read;
dontaudit untrusted_app selinuxfs:file read;
dontaudit untrusted_app vendor_persist_camera_prop:file read;
dontaudit untrusted_app vendor_oplus_prop:file read;
dontaudit untrusted_app mnt_vendor_file:dir search;
dontaudit untrusted_app media_userdir_file:dir search;
dontaudit untrusted_app media_rw_data_file:file relabelfrom;
dontaudit untrusted_app userdata_block_device:blk_file r_file_perms;
dontaudit untrusted_app init_exec:lnk_file read;
