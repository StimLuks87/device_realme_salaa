dontaudit system_server proc_gpufreq:dir r_dir_perms;
dontaudit system_server proc_irq:dir r_dir_perms;
dontaudit system_server vendor_proc_oplus_version:dir r_dir_perms;
dontaudit system_server vendor_proc_oplus_sensor_feature:dir r_dir_perms;
dontaudit system_server vendor_variant_prop:file read;
allow system_server vendor_proc_charger:dir search;
allow system_server vendor_proc_display:dir search;
allow system_server vendor_sysfs_usb_supply:dir search;
allow system_server vendor_sysfs_usb_supply:file r_file_perms;
allow system_server vendor_proc_oplus_sensor_als:dir search;
allow system_server vendor_proc_oplus_fastchg:dir search;
allow system_server vendor_proc_oplus_fastchg:file r_file_perms;
allow system_server vendor_sysfs_battery_supply:dir search;
allow system_server vendor_sysfs_battery_supply:file r_file_perms;
